{
  "name": "Email Writer Extension",
  "description": "AI powered email writing assistant.",
  "version": "1.0",
  "manifest_version": 3,
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:8080/*", "*://mail.google.com/*"
    ],
  "action": {
    "default_title": "Email Writer Extension"
  },
  "background": {
  "service_worker": "background.js"
},

"content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": ["*://mail.google.com/*"],
        "run_at": "document_end"
    }
  ], 
  "web_accessible_resources": [
    {
      "resources": [ "icons/*" ],
      "matches": [ "*://mail.google.com/*" ]
    }
  ]
}